# Step 6 - Auth0. Copy this file to .env and fill in your values.
# Create a free "Single Page Application" at https://auth0.com, then read Domain + Client ID
# from its Settings. Add http://localhost:5190 to Allowed Callback URLs, Logout URLs, and Web Origins.
# The app runs fine WITHOUT these - Step 6 just shows setup instructions until they're set.

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id
